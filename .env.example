# PostgreSQL database (DGS intern netwerk)
DB_HOST=192.168.23.254
DB_PORT=5432
DB_NAME=db_dgs_01
DB_USER=
DB_PASSWORD=

# App configuratie
APP_PORT=8080
APP_HOST=0.0.0.0

# HTTP Basic Auth. VERPLICHT voor productie/klant-deploy: de app weigert te starten
# zonder deze waarden (alle routes vereisen dan login, behalve /api/health).
# Gebruik een sterk, willekeurig wachtwoord (min. 16 tekens).
DASHBOARD_AUTH_USER=
DASHBOARD_AUTH_PASSWORD=
# Bewuste escape voor een AFGESCHERMDE interne/test-omgeving: laat de app zonder auth
# starten. NOOIT op een klant-/productie-deploy zetten. Leeg = veilige default (auth vereist).
ALLOW_NO_AUTH=

# Logging (text = leesbaar in terminal, json = gestructureerd voor Docker/Loki)
LOG_FORMAT=text
LOG_LEVEL=INFO

# OpenRouter API (Chat-functie in dashboard)
OPENROUTER_API_KEY=
# Model via OpenRouter (default: anthropic/claude-sonnet-4)
# Voorbeelden: google/gemini-2.5-flash, openai/gpt-4o, anthropic/claude-haiku-4-5
CHAT_MODEL=anthropic/claude-sonnet-4

# Aparte read-only DB-rol voor de AI-chat. VERPLICHT in productie: zonder deze rol wordt de
# chat uitgeschakeld (i.p.v. terug te vallen op de schrijf-bevoegde hoofd-pool). In interne
# modus (ALLOW_NO_AUTH=1) is de fallback wel toegestaan.
CHAT_DB_USER=
CHAT_DB_PASSWORD=
# Dagelijks token-budget voor de chat (kosten-/misbruik-rem over alle gebruikers samen).
# 0 = onbeperkt. 300000 dekt ~5 actieve gebruikers/dag comfortabel; daarboven = waarschijnlijk
# misbruik -> 503. Zet daarnaast ALTIJD een spend-limit op de OpenRouter-key zelf.
CHAT_DAILY_TOKEN_BUDGET=300000
# TLS naar OpenRouter: laat leeg/true voor veilig. Achter SSL-inspectie:
# wijs CHAT_CA_BUNDLE naar de bedrijfs-root-CA (aanbevolen), of zet CHAT_TLS_VERIFY=false.
CHAT_TLS_VERIFY=true
CHAT_CA_BUNDLE=

# Lokale dev (nep-DB): prod-spiegel op poort 5434, of vlakke dev-DB op 5433.
# Zie CLAUDE.md "Lokale ontwikkeling".

# MCP Server (Claude Code PostgreSQL-koppeling)
DGS_DB_CONNECTION_STRING=postgresql://<user>:<password>@192.168.23.254:5432/db_dgs_01

# Observability-stack (docker-compose.observability.yml). Grafana vereist nu een inlog;
# zonder dit wachtwoord start de observability-stack niet (geen anonieme Admin meer).
GRAFANA_ADMIN_PASSWORD=

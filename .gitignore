.env
.env.dev
.env.local
__pycache__/
*.pyc
.venv/
node_modules/
static/
frontend/dist/
.vite/
logs/

# TypeScript wordt door Vite gebundeld; tsc draait alleen als type-check (noEmit).
# Stray .js naast .tsx is build-output en hoort niet in de repo.
frontend/src/**/*.js
frontend/tsconfig.tsbuildinfo

# Office tijdelijke lock-bestanden
~$*

# Gebouwde Docker-images (deploy-artefacten, kunnen tientallen MB groot zijn)
*.tar
*.tar.gz

# Bedrijfs-CA voor builds achter SSL-inspectie (lokaal houden, niet delen)
certs/*
!certs/.gitkeep

# IXrouter5 build-config met secrets (alleen het .example-bestand wordt gecommit)
.ixrouter.env

# Gegenereerde dummy-data seed (groot, regenereerbaar via build-ixrouter-db.sh)
db/seed.sql

# Interne werkmap: klant-/project-administratie (backlog, TODO, onderzoeken, klant-docs).

# Kopieer naar .ixrouter.env en vul in. NIET committen (staat in .gitignore) - bevat secrets.
# Deze waarden worden in het Docker-image gebakken (de IXrouter5 kan ze niet bij het starten meegeven).

# Router
ROUTER_IP=192.168.140.1
APP_PORT=9000

# Database (extern, bereikbaar vanaf de router) - op poort 5432
DB_HOST=192.168.23.254
DB_PORT=5432
DB_NAME=db_dgs_01
DB_USER=CHANGE_ME
DB_PASSWORD=CHANGE_ME

# Chat (aan) - OpenRouter
OPENROUTER_API_KEY=CHANGE_ME
CHAT_MODEL=anthropic/claude-sonnet-4
# Aparte read-only DB-rol voor de chat. VERPLICHT bij de klant: zonder deze rol schakelt
# de chat zichzelf uit (i.p.v. als schrijf-gebruiker te draaien). Zie CLAUDE.md voor de SQL.
CHAT_DB_USER=chat_readonly
CHAT_DB_PASSWORD=CHANGE_ME
CHAT_TLS_VERIFY=true
# CHAT_CA_BUNDLE=    # alleen invullen achter SSL-inspectie (pad naar CA in het image)
# Dagelijks chat-token-budget (kosten-/misbruik-rem). 0 = onbeperkt. Zet ook een spend-limit
# op de OpenRouter-key zelf.
CHAT_DAILY_TOKEN_BUDGET=300000

# Toegangsbeveiliging. VERPLICHT bij de klant: zonder deze waarden START DE APP NIET
# (veilige default). Kies een sterk, willekeurig wachtwoord (min. 16 tekens).
DASHBOARD_AUTH_USER=CHANGE_ME
DASHBOARD_AUTH_PASSWORD=CHANGE_ME

# Logging
LOG_FORMAT=json
LOG_LEVEL=INFO

# Bouwen achter SSL-inspectie (DGS-netwerk)? Zet op 1 en leg het bedrijfs-root-CA
# als .crt in de map certs/. Standaard 0 (geen CA nodig, bv. bouwen met VPN uit).
INSTALL_CORP_CA=0

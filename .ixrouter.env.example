# Kopieer naar .ixrouter.env en vul in. NIET committen (staat in .gitignore).
#
# Dit bestand bevat alleen BUILD-instellingen. Het image is secret-vrij: alle
# app-config (database, auth, chat) geef je op als environment-variabelen bij het
# aanmaken van de container in het IXON-portaal. Zie DEPLOY-ixrouter.md voor de
# volledige lijst (DB_HOST, DB_PORT, DB_NAME, DB_USER, DB_PASSWORD,
# DASHBOARD_AUTH_USER, DASHBOARD_AUTH_PASSWORD, OPENROUTER_API_KEY, CHAT_*, LOG_*).

# Router (registry + poort waarop het dashboard komt te draaien)
ROUTER_IP=192.168.23.254
APP_PORT=9000

# Bouwen achter SSL-inspectie? Zet op 1 en leg het bedrijfs-root-CA als .crt in certs/.
# Standaard 0 (geen CA nodig, bv. bouwen met VPN uit).
INSTALL_CORP_CA=0
